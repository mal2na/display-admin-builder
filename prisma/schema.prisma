// 전시/관리 어드민 빌더 — 데이터 모델 (Phase 1)
// 개념/상태값의 단일 진실 원본은 프로젝트 루트 CLAUDE.md.
// 정책서: NC_전시관리기능_정책서_간소화_v0.31.html (POL-DSP v0.31)
//
// [주의] SQLite 커넥터는 Prisma의 `enum`을 지원하지 않는다.
//   → 모든 유형/상태는 String으로 저장하고, 허용값은 src/lib/display-taxonomy.ts 의
//     상수로 관리한다. 애플리케이션/시드 레벨에서 그 상수로 검증한다.
//   → 실제 DB(Postgres 등)로 교체하면 그때 native enum으로 승격할 수 있다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────────────────────
// 1. Atom — 가장 작은 표시 요소 (Component의 재료로만 쓰인다)
// ─────────────────────────────────────────────────────────────
model Atom {
  id       String @id @default(cuid())
  name     String // 운영자용 식별명
  atomType String // TEXT | BUTTON | IMAGE | ICON | INFO  (display-taxonomy.ATOM_TYPES)

  content String? // 문구/가격/혜택문구/정보값 등 텍스트성 값 (기본=미리보기에 노출)
  // 문구 베리에이션 (회의 2026-08-31) — 운영자가 문구 후보를 여러 개 등록하고, 실서비스에선 CVM이 고객마다 택1.
  //  JSON 문자열 배열. 빌더 미리보기는 폴백이라 기본(content)만 노출. '재료는 우리가, 조합은 CVM'.
  contentVariants String?
  imageUrl String? // IMAGE / ICON 의 에셋 경로
  altText String? // 대체텍스트. IMAGE/ICON이면 draft는 허용하되 review 전환은 차단 (PI-DSP-CMP-004)
  linkUrl String? // 랜딩/버튼 링크
  status  String  @default("active") // 재료 상태: active(사용) | inactive(미사용)

  componentAtoms ComponentAtom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// 2. Component — Atom을 조합한 기능 모듈. 반드시 6개 유형 중 하나.
// ─────────────────────────────────────────────────────────────
model Component {
  id            String  @id @default(cuid())
  name          String
  componentType String // 정보형 | 행동형 | 혜택형 | 선택형 | 배너형 | 상품형 (COMPONENT_TYPES)
  description   String?
  status        String  @default("active") // 재료 상태: active(사용) | inactive(미사용)
  selectedIndex Int     @default(0) // 선택형(칩/탭)에서 기본 활성 칩 인덱스 (ChipPage Selection)
  chipRows      Int     @default(1) // 선택형 칩 표시 줄 수 (1줄 | 2줄)

  // 운영자가 이 Component를 쓸 수 있는 Corner 유형을 좁힌 값(JSON 배열 문자열).
  // null/빈 값 = CORNER_COMPONENT_MAP상 호환되는 모든 Corner 유형 허용. (PI-DSP-CMP-003 하위 제약)
  allowedCornerTypes String?

  componentAtoms   ComponentAtom[]
  cornerComponents CornerComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Component ↔ Atom (조합, 순서 + 필수/선택 구분)
model ComponentAtom {
  id          String @id @default(cuid())
  componentId String
  atomId      String
  order       Int     // Component 안에서의 표시 순서
  isRequired  Boolean @default(true) // 필수 Atom / 선택 Atom
  visible     Boolean @default(true) // 코너 구성에서 표시/숨김 토글 (숨김 시 미리보기·FO 제외, 삭제 아님)
  // 고객 메뉴 역할(선택형·메뉴 리스트): FIXED(고정·고객 삭제 불가) | EDITABLE(기본 노출·고객 편집 가능)
  menuRole    String  @default("EDITABLE")

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  atom      Atom      @relation(fields: [atomId], references: [id])

  @@unique([componentId, atomId])
  @@index([componentId])
}

// ─────────────────────────────────────────────────────────────
// 3. Corner — Component를 올려놓는 화면 영역. corner_type이 허용 component_type을 제한.
// ─────────────────────────────────────────────────────────────
model Corner {
  id           String  @id @default(cuid())
  name         String
  cornerType   String // 8종 (CORNER_TYPES). corner_type → 허용 component_type: CornerComponentRule / CORNER_COMPONENT_MAP
  typeLabel    String? // 표시 유형명 오버라이드 (예: 복합형). null이면 cornerType 카탈로그 표시명 사용
  title        String? // (레거시) 노출 타이틀 — 신규 화면은 mainTitle 사용
  maxItems     Int?    // 최대 노출 개수
  sortStrategy String? // 정렬 기준: MANUAL | PRIORITY | RECENT ...
  status       String  @default("active") // 재료 상태: active(사용) | inactive(미사용)

  // ── 코너 검수 워크플로우 (정책서 마.상태전이표 / PG-DSP-WFL-001) ──
  //    코너 단위로 생성 → 검수 요청 → 승인/반려. 템플릿 status와 별개로 코너마다 관리.
  //    DRAFT 초안 작성중 | REVIEW 검수 대기 | APPROVED 승인 완료 | REJECTED 수정 필요
  reviewStatus String  @default("DRAFT")
  reviewReason String? // 반려 사유 (reviewStatus = REJECTED)
  reviewedBy   String? // 검수(승인/반려) 처리자
  reviewedAt   DateTime? // 검수 처리 시각

  // ── T우주 코너 정보 컬럼 (코너1·코너2 참고) ──
  markupId     String? // 코너 마크업 ID (예: CMUID00030)
  layoutDetail String? // 유형 상세 (예: 가로형(2.5배열), 팝업배너형, 세로형 …)
  cornerLayout String? // 코너 레이아웃 (예: 가로 SWIPE형)
  description  String? // 코너 설명
  mainTitle    String? // 메인 타이틀 (줄바꿈 \n 허용)
  // 타이틀 베리에이션 — 타겟별 대체 타이틀. JSON [{text,target}]. 실서비스 CVM이 택1(기본=mainTitle). 회의 2026-08-31.
  mainTitleVariants String?
  subTitle     String? // 서브 타이틀
  subTitleIcon String? // 서브 타이틀 아이콘 (사용안함 | 말줄임표 | 화살표 | 정보)

  // ── 상품형 코너 전용 컬럼 (코너3·코너4 참고) ──
  minItems           Int?    // 최소 노출 개수
  noDisplayCondition String? // 미 노출 조건 (선택 없음 | 재고 소진 시 | 혜택 종료 시 | 개인화 제한 시)
  // 추천 수급 방식 (개인화 추천형·상품형 전용) — '콘텐츠를 어디서 가져오나'의 축. CVM(개인화) / 운영자 편성(직접 구성 폴백) 둘뿐.
  //  ('채널 데이터'는 CVM에 흡수, '룰 기반'은 타겟팅 축이라 Template 분기·코너 노출 조건으로 분리 — 수급에서 제거)
  recSource String? // (대표) 1순위 수급 방식 — null | CVM 기반 | 운영 편성 | 수동 대체
  // 여러 수급 방식을 우선순위로 편성. JSON 배열, 1순위→폴백 순. 예: ["CVM 기반","운영 편성"] = CVM 우선, 없으면 운영자 편성(직접 구성).
  recSourcePlan String?
  // 추천 근거(추천 사유) 카드 표시 여부 (PG-REC-CARD-001 / TM-REA-005). 값은 CVM이 런타임 제공, 여기선 표시 on/off만.
  showRecReason Boolean @default(false)
  moreButtonUse      Boolean @default(false) // 더보기 사용 여부
  moreButtonLabel    String? // 더보기 버튼명
  moreButtonLink     String? // 더보기 랜딩 URL

  // 배너형 코너에 연결된 배너 라이브러리 항목 (포탈2 BannerSlot)
  bannerId String?
  banner   Banner? @relation(fields: [bannerId], references: [id])
  // ── FO 사용자 설정(고객 커스터마이즈) — 자주 보는 메뉴 등 선택형·메뉴 리스트 코너 ──
  //  BO는 기본값(항목·고정 여부)을 제공하고, userCustomizable가 켜지면 FO 고객이 편집 가능.
  //  이때 고객이 노출할 수 있는 개수 범위를 userMinItems~userMaxItems로 제한한다(고정 항목 포함).
  userCustomizable Boolean @default(false)
  userMinItems     Int?    // 고객이 최소 이만큼은 노출(고정 항목 포함)
  userMaxItems     Int?    // 고객이 최대 이만큼까지 노출 가능

  // 빅배너 = 코너 유형이 아니라 '배치(인스턴스) 옵션'(TM-DSP-019). 빌더에서 코너를 배치할 때 켠다.
  //  같은 세로형 코너를 A화면은 빅배너로, B화면은 일반으로 배치 가능 → 유형이 아닌 인스턴스 단위.
  bigBanner Boolean @default(false)
  // 상품형 가로형(2.5배열) 카드 모양 — 정사각형(상품 이미지) | 직사각형(영화 포스터 등 세로 3:4). 빌더에서 선택.
  cardShape String? // null=기본(직사각형) | 정사각형 | 직사각형
  titleLines Int? // 상품 카드 제목 줄 수 (null/1=한 줄 말줄임, 2=두 줄까지 표시)
  // 노출 타입 베리에이션 (회의 2026-08-31) — 한 코너에 디자인/노출 타입을 2~3개 등록하고, 실서비스에선 CVM이 고객마다 택1.
  //  JSON 배열 [{label, note}]. 빌더 미리보기는 폴백이라 기본(첫 번째) 타입만 표시. '껍데기 베리에이션'.
  displayVariants String?
  // 빅배너(상품형 등 코너에 얹는 부속 배너)의 위치 — 빌더에서 배치 조정. 상단 | 하단 (배너형 코너는 무관)
  bannerPosition String? @default("상단")
  // 코너 유형 관리에서 불러올 때 상속받은 유형 샘플 썸네일 — 컴포넌트가 아직 없을 때 미리보기/카드에 표시
  sampleImageUrl String?
  // 이 코너가 어느 코너 유형(카탈로그)에서 생성됐는지 — 사용처(영향 범위) 추적용. CornerType.id.
  sourceCornerTypeId String?

  cornerComponents CornerComponent[]
  templateCorners  TemplateCorner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Corner ↔ Component (배치, 순서). corner_type 제약은 앱/시드에서 CORNER_COMPONENT_MAP로 검증.
model CornerComponent {
  id          String @id @default(cuid())
  cornerId    String
  componentId String
  order       Int

  corner    Corner    @relation(fields: [cornerId], references: [id], onDelete: Cascade)
  component Component @relation(fields: [componentId], references: [id])

  @@unique([cornerId, componentId])
  @@index([cornerId])
}

// ─────────────────────────────────────────────────────────────
// 4. Template — 여러 Corner를 순서/배치로 구성한 레이아웃. Container에 속한다.
//    10단계 전시 워크플로우 상태(status)가 여기 붙는다.  ← 정책서 "마. 상태 전이표"
// ─────────────────────────────────────────────────────────────
model Template {
  id             String    @id @default(cuid())
  containerId    String
  name           String
  conditionGroup String // 조건 그룹: 비로그인 | 로그인 | 조건충족 | 조건미충족 | (운영자 정의 커스텀)
  isDefault      Boolean   @default(false) // 이 Container의 기본 Template 여부
  memo           String? // 메모 (템플릿.png: 30자 이내)
  displayOn      Boolean   @default(true) // 전시 여부 (전시/미전시) — 워크플로우 status와 별개
  startAtOnApproval Boolean @default(false) // 전시 기간 시작일을 승인일시로 설정
  startAt        DateTime? // 기간형 Template 시작 (nullable = 상시)
  endAt          DateTime? // 기간형 Template 종료 (nullable = 상시)
  priority       Int       @default(0) // 우선순위 (정책서: 우선순위)
  status         String    @default("DRAFT") // 10단계 (DISPLAY_STATUS key). ST-DSP-001~010
  version        Int       @default(1) // 롤백 대상 버전 식별 (PI-DSP-RBK-002)
  rejectReason   String? // 반려 사유 (status = REJECTED / 수정 필요)

  // 보관(soft-delete). null = 활성, 값 있으면 보관됨(목록에서 숨김, 복구 가능)
  archivedAt DateTime?
  archivedBy String?

  // 폐기(삭제 대체) 승인 워크플로우 — '승인된 적 있는' 템플릿만 사용(미승인 초안은 물리 삭제 허용).
  //  null = 정상 | REVIEW = 폐기 승인 대기 | RETIRED = 폐기됨(보관 처리). 컨테이너 폐기와 동일 개념.
  retireStatus      String? // null | REVIEW | RETIRED
  retireReason      String?
  retireRequestedAt DateTime?
  retiredBy         String?
  retiredAt         DateTime?

  // 게시 중지 기록 (PG-DSP-WFL / 상태 전이표: 게시 중 → 게시 중지, 사유·실행자·실행시각 필수)
  suspendReason String? // 중지 사유
  suspendedBy   String? // 실행자
  suspendedAt   DateTime? // 실행 시각

  // 직전 승인 완료 버전 (롤백 대상 — PI-DSP-RBK-002)
  lastApprovedVersion Int? // 마지막으로 APPROVED 되었던 시점의 version
  publishedAt         DateTime? // 실제 게시 전환 시각

  container       Container        @relation("ContainerTemplates", fields: [containerId], references: [id])
  templateCorners TemplateCorner[]
  versions        TemplateVersion[]
  defaultOf       Container?       @relation("DefaultTemplate") // 이 Template을 기본으로 지정한 Container (1:1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([containerId])
}

// 템플릿 버전 스냅샷 (임시저장 / 버전 되돌리기 — PG-DSP-RBK-001, PI-DSP-RBK-002)
// snapshot = 구조 전체(meta + corners→components→atoms)를 JSON 문자열로 보관.
model TemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  version    Int // 스냅샷 시점의 template.version
  label      String? // '임시저장' | '되돌리기 전 자동저장' 등
  snapshot   String // 구조 JSON
  createdBy  String?
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// Template ↔ Corner (배치, 세로 순서)
model TemplateCorner {
  id         String  @id @default(cuid())
  templateId String
  cornerId   String
  order      Int // Template 안에서 Corner의 세로 배치 순서
  visible    Boolean @default(true) // 이 Template에서 노출/비노출 (전시 여부)

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  corner   Corner   @relation(fields: [cornerId], references: [id])

  @@unique([templateId, cornerId])
  @@index([templateId])
}

// ─────────────────────────────────────────────────────────────
// 5. Container — 채널에 실제로 나가는 화면/영역 단위. 화면과 1:1, Template과 1:N.
//    삭제하지 않고 status(active/inactive)로 관리. 기본 Template 1개 필수.
// ─────────────────────────────────────────────────────────────
model Container {
  id            String  @id @default(cuid())
  name          String
  containerType String? // MAIN | MENU | CURATION | BENEFIT ... (메인화면/메뉴/기획전/혜택영역)
  channel       String? // APP | WEB ...
  status        String  @default("active") // active | inactive (= 전시/미전시. soft-delete만 허용, 물리 삭제 없음)

  // ── 승인 워크플로우 (컨테이너 단위) ──
  // DRAFT 작성중 → REVIEW 승인 대기 → APPROVED 승인 완료 / REJECTED 반려. status(전시/미전시)와는 별개.
  approvalStatus      String    @default("DRAFT") // DRAFT | REVIEW | APPROVED | REJECTED
  approvalRequestedAt DateTime? // 승인 요청 시각
  approvedBy          String? // 승인 담당자
  approvedAt          DateTime? // 승인 완료 시각
  rejectReason        String? // 반려 사유

  // ── 폐기(삭제 대체) 승인 워크플로우 ──
  // 컨테이너는 물리 삭제하지 않는다. '폐기'는 승인이 필요: 운영자 요청 → BSS 승인 시 미전시(inactive) + 폐기됨.
  //   retireStatus: null(정상) | REVIEW(폐기 승인 대기) | RETIRED(폐기 완료). 반려 시 null로 복귀.
  retireStatus      String? // null | REVIEW | RETIRED
  retireReason      String? // 폐기 요청 사유 / 반려 사유
  retireRequestedAt DateTime? // 폐기 요청 시각
  retiredBy         String? // 폐기 승인 담당자(BSS)
  retiredAt         DateTime? // 폐기 승인(확정) 시각

  // ── T우주 "컨테이너 기본 정보" (컨테이너정보 화면 참고) ──
  parentId   String? // 상위 컨테이너
  parent     Container?  @relation("ContainerHierarchy", fields: [parentId], references: [id])
  children   Container[] @relation("ContainerHierarchy")
  kind       String    @default("일반") // 컨테이너 타입: 일반 | 코너관리용
  platform   String    @default("모바일") // 모바일 | PC
  previewUrl String? // 미리보기 URL
  startAt    DateTime? // 전시 기간 시작
  endAt      DateTime? // 전시 기간 종료
  noEndDate  Boolean   @default(false) // 종료 없음

  // ── T우주 "메타 정보" ──
  metaUse         Boolean @default(true) // 사용 여부
  searchTags      String? // 검색 태그 (#키워드)
  metaKeywords    String? // meta keywords
  metaDescription String? // meta description
  ogTitle         String? // og:title
  ogDescription   String? // og:description
  ogSiteName      String? // og:site_name
  ogImage         String? // og:image (URL)

  // 기본 Template. 논리적으로 필수지만, 최초 생성 시 Template이 아직 없어 순환이 생기므로
  // DB에서는 nullable로 두고 "반드시 1개"는 앱/시드 레벨에서 보장한다.
  defaultTemplateId String?   @unique
  defaultTemplate   Template? @relation("DefaultTemplate", fields: [defaultTemplateId], references: [id])

  templates Template[] @relation("ContainerTemplates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// 배너 라이브러리 — 기존 배너 재사용 + 신규 등록 (포탈2 참고)
// ─────────────────────────────────────────────────────────────
model Banner {
  id       String  @id @default(cuid())
  name     String
  imageUrl String // 배너 이미지 경로/URL (BannerSrc)
  linkUrl  String? // 배너 클릭 시 랜딩
  status   String  @default("active") // active | inactive

  corners   Corner[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// 5-b. CornerType — 코너 유형 카탈로그 (T우주 "코너 유형 관리")
//   운영자가 재사용할 코너 유형을 등록/관리한다. 코너를 만들 때 이 카탈로그에서 유형을 고른다.
//   baseCategory 는 컴포넌트 매핑(CORNER_COMPONENT_MAP, PI-DSP-CMP-003)을 위한 내부 8분류 키.
//   name 은 화면 표기명(관리 대상) — T우주 이미지 기준으로 붙이거나 신규로 등록.
// ─────────────────────────────────────────────────────────────
model CornerType {
  id           String  @id @default(cuid())
  typeId       String  @unique // 표시용 코너 유형 ID (예: CY0000001)
  name         String // 표시명 (관리 대상)
  baseCategory  String // ① 코너 유형: CORNER_TYPES 8종 중 하나 (정책 PI-DSP-CMP-003)
  componentType String? // ② 구성 컴포넌트 유형: 코너에 담기는 모듈(6종). CORNER_COMPONENT_MAP으로 제한
  markupId      String? // 코너 마크업 ID (예: CMUID00030)
  typeDetail    String? // ③ 배열/레이아웃 상세 (예: 가로형(2.5배열), 세로형 …) — 순수 배열만(빅배너 접미사 제거)
  bigBanner     Boolean @default(false) // ④ 빅배너 구분자: 상단 빅배너 부속 유무(배열과 직교, TM-DSP-019)
  layout       String? // 코너 레이아웃 (예: 가로 SWIPE형)
  description  String?

  channels  String  @default("전체") // 운영 채널 csv: 전체 | FO | BO
  platforms String  @default("모바일") // 운영 플랫폼 csv: 전체 | 모바일 | PC
  active    Boolean @default(true) // 사용 여부

  // 세부 항목(항목별 사용여부) — T우주 코너 유형 정보 하단
  useMainTitle  Boolean @default(true)
  useSubTitle   Boolean @default(true)
  useMinItems   Boolean @default(true)
  useMaxItems   Boolean @default(true)
  useNoDisplay  Boolean @default(true)
  useMoreButton Boolean @default(true)

  // 타입-레벨 기본값(템플릿 강화) — 이 유형으로 빌더에서 코너를 만들 때 기본 상속(코너별 수정 가능).
  defaultMinItems       Int?    // 기본 노출 개수(하한)
  defaultMaxItems       Int?    // 최대 노출 개수 — 정책서 Corner 구성 기준(노출 순서·최대 노출 개수)
  defaultSortStrategy   String? // 기본 정렬 기준: MANUAL | PRIORITY | RECENT | POPULAR | PRICE_ASC | PRICE_DESC
  defaultRecSource      String? // 기본 추천 수급 방식 (상품형·개인화 추천형): CVM 기반 | 채널 데이터 | 룰 기반 | 운영 편성 | 수동 대체. 코너 불러오기 시 corner.recSource로 상속.
  defaultMoreButton     Boolean @default(false) // 더보기 버튼 기본 ON 여부(라벨은 아래, 링크는 코너별 입력)
  defaultMoreButtonLabel String? // 더보기 기본 라벨(예: 더보기, 전체보기)
  // CVM 연동 필드 — 이 코너 유형이 CVM/BSS에서 자동으로 가져오는 회원 데이터(FN-EVTMSN-FORM-001). CVM_FIELDS key csv.
  cvmFields String @default("")

  // ── FO 사용자 설정(고객 커스터마이즈) 기본값 — 선택형·메뉴 리스트 유형에서. 코너 불러오기 시 코너에 상속. ──
  userCustomizable Boolean @default(false)
  userMinItems     Int?
  userMaxItems     Int?

  sampleImageUrl String? // 유형 샘플 이미지
  // ── 승인 워크플로우 (편집본 status) ──
  //  코너 승인은 이 코너 유형 단위로 BSS에 승인 요청한다(운영자는 요청만, 승인/반려는 BSS).
  //  status = '작업본(편집본)'의 승인 상태이지, 라이브 사용 여부가 아니다. 사용 여부는 liveVersion으로 판정.
  status         String  @default("APPROVED") // DRAFT 임시저장 | REVIEW 승인대기 | APPROVED 승인완료 | REJECTED 승인반려
  rejectReason   String? // BSS 반려 사유 (status = REJECTED)
  reviewedBy     String? // 승인/반려 처리 주체 (BSS)
  reviewedAt     DateTime? // 승인/반려 처리 시각
  // ── 버전관리 (라이브 승인본 ↔ 작업본 분리) ──
  //  라이브 승인본은 재검수 중에도 유지된다. 승인완료 후 운영자가 '반영(사용)'을 눌러야 라이브로 승격(수동 게시).
  workingVersion Int      @default(1) // 편집본 버전 (수정 착수 시 증가)
  liveVersion    Int?     // 현재 사용(반영)된 승인본 버전. null = 아직 라이브 없음(미사용)
  liveSnapshot   String?  // 반영된 승인본 정의 스냅샷(JSON) — 불러오기/노출의 정본. 재검수 중에도 이 값이 쓰인다.
  liveAt         DateTime? // 마지막 반영(게시) 시각
  createdBy      String? // 등록자

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// 6. CornerComponentRule — corner_type별 허용 component_type 매핑 (PI-DSP-CMP-003)
//    권위 있는 원본은 src/lib/display-taxonomy.ts 의 CORNER_COMPONENT_MAP.
//    이 테이블은 그 상수를 시드로 넣어 어드민에서 조회/검증 가능하게 한 사본.
// ─────────────────────────────────────────────────────────────
model CornerComponentRule {
  id            String @id @default(cuid())
  cornerType    String // CORNER_TYPES 중 하나
  componentType String // COMPONENT_TYPES 중 하나

  @@unique([cornerType, componentType])
}

// ─────────────────────────────────────────────────────────────
// 7. AuditLog — 감사 로그 (PI-DSP-AUD-002)
//    변경자 / 변경일시 / 대상 타입·ID / 이전값 / 이후값 / 사유 / 승인자 / 결과
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(cuid())
  actor       String // 변경자
  changedAt   DateTime @default(now()) // 변경일시
  targetType  String // 대상 타입: Container | Template | Corner | Component | Atom
  targetId    String // 대상 ID
  beforeValue String? // 이전값 (JSON 직렬화 문자열)
  afterValue  String? // 이후값 (JSON 직렬화 문자열)
  reason      String? // 변경 사유
  approver    String? // 승인자
  result      String // 결과: CREATED | UPDATED | APPROVED | REJECTED | PUBLISHED | SUSPENDED | ROLLED_BACK ...

  @@index([targetType, targetId])
  @@index([changedAt])
}

// ═════════════════════════════════════════════════════════════
// 이벤트 페이지 빌더 (프리폼 컴포넌트 빌더 — nebula-builder 레퍼런스)
//   Project(EventProgram) → Page(EventPage) → Node 트리(EventNode)
//   컴포넌트 카탈로그 SSOT: src/lib/event-components.ts
// ═════════════════════════════════════════════════════════════

// ── EventNode — 페이지를 이루는 컴포넌트(자기참조 트리).
//    type = TEXT|TABLE|IMAGE|BUTTON|ACCORDION|CARD|HROW|VSTACK|DIVIDER|HTML|ROULETTE
//    컨테이너(CARD/HROW/VSTACK/ACCORDION)는 children으로 중첩. props(JSON)에 모든 설정.
model EventNode {
  id       String  @id @default(cuid())
  pageId   String
  parentId String? // null = 페이지 루트 직속
  type     String
  order    Int     @default(0)
  props    String? // JSON: 콘텐츠/여백/variant/레이아웃/HTML 등

  page     EventPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent   EventNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children EventNode[] @relation("NodeChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId])
  @@index([parentId])
}

// ── E4. Page — Template급 레이아웃. 운영자 워크플로우 상태(12단계)가 붙는다. ──
model EventPage {
  id             String  @id @default(cuid())
  programId      String
  name           String
  conditionGroup String  @default("전체") // 조건 그룹: 비로그인|로그인|초청대상|세그먼트… (분기)
  isDefault      Boolean @default(false)
  memo           String?
  pageType       String  @default("빌더") // 빌더 | 팝업 | 시트
  device         String  @default("iPhone 17 Pro") // 편집 기준 디바이스

  // 운영자 워크플로우 상태 (OPS_STATUSES). PI-EVTMSN-APPROVAL-001-01
  status  String @default("DRAFT")
  version Int    @default(1)

  // 배포/기간 (PG-EVTMSN-DEPLOY-001)
  deployMode String? // 즉시/예약/단계/일부채널 선배포
  startAt    DateTime?
  endAt      DateTime?
  noEndDate  Boolean   @default(false)

  // 검수 반려 / 중지 / 롤백 기록 (변경자·사유·시각 필수 — PI-EVTMSN-APPROVAL-001-01)
  rejectReason        String?
  suspendScope        String? // SUSPEND_SCOPES
  suspendReason       String?
  suspendedBy         String?
  suspendedAt         DateTime?
  lastApprovedVersion Int?
  deployedAt          DateTime?

  archivedAt DateTime?
  archivedBy String?

  // 본문 빌더 통합 — 프로모션 본문을 전시 빌더 엔진(Template→Corner→Component→Atom)으로 구성.
  //  숨김 Container(containerType='PROMOTION') 아래 Template 1개를 만들어 연결. 코너 유형은 이벤트/미션(EV*)만.
  bodyTemplateId String?

  program   EventProgram       @relation("ProgramPages", fields: [programId], references: [id])
  nodes     EventNode[]
  versions  EventPageVersion[]
  defaultOf EventProgram?      @relation("DefaultPage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}

// 페이지 버전 스냅샷 (임시저장 / 롤백 — PI-EVTMSN-DEPLOY-001-03)
model EventPageVersion {
  id        String   @id @default(cuid())
  pageId    String
  version   Int
  label     String?
  snapshot  String // 구조 JSON
  createdBy String?
  createdAt DateTime @default(now())

  page EventPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

// ── E5. Program — Container급 채널 노출 단위. 화면과 1:1, Page와 1:N. ──
//    삭제하지 않고 status(active/inactive)로 관리. 복합구조면 하위 구성요소(자기참조).
model EventProgram {
  id           String  @id @default(cuid())
  name         String
  programKind  String // 이벤트 | 미션 (PROGRAM_KINDS)
  programType  String // 이벤트 6종 또는 미션 10종 (대표 유형)
  purpose      String? // 운영 목적 (PI-EVTMSN-ADMIN-001-02 등록 항목)
  createsState Boolean @default(true) // 상태 생성 여부 — 유형으로 자동 결정 (PI-EVTMSN-PROG-001-06: 안내형·기획전형=false)
  status       String  @default("active") // active | inactive (soft-delete)
  env          String  @default("LOCAL") // LOCAL | DEV | STG | PRD (프로젝트 배포 환경)
  category     String? // 템플릿 카테고리: T멤버십 | T우주 | TDS | TWORLD
  mode         String  @default("event") // event(오픈 모드) | display(거버넌스 모드: 코너 기반)

  // ── SB-EVT-012 프로그램 기본 정보 등록 항목 ──
  partnerBrand String? // 제휴 브랜드
  thumbnail    String? // 썸네일 이미지 (URL/data URI)
  thumbnailAlt String? // 썸네일 대체텍스트(ALT) — 필수 고지/접근성
  displayState String  @default("미노출") // 전시 상태: 미노출 | 노출
  commentUse   Boolean @default(false) // 댓글 여부

  // 전시 기간 (운영 기간과 별개 — 화면 노출 기간)
  displayStartAt   DateTime?
  displayEndAt     DateTime?
  displayNoEndDate Boolean   @default(false)

  // 검색 및 태그 관리 (SEO)
  searchExposed   Boolean @default(false) // 검색 노출 여부
  searchTags      String? // 검색 태그(#키워드)
  metaKeywords    String?
  metaDescription String?
  ogTitle         String?
  ogDescription   String?
  ogSiteName      String?
  ogImage         String?

  // 복합 구조 (PG-EVTMSN-COMPOSITE-001) — 대표 프로그램 / 하위 구성요소
  isComposite Boolean        @default(false)
  parentId    String?
  parent      EventProgram?  @relation("ProgramComposite", fields: [parentId], references: [id])
  children    EventProgram[] @relation("ProgramComposite")

  // 공개 범위 / 진입점 (PI-EVTMSN-ADMIN-DISPLAY-001-01)
  visibility  String  @default("전체 공개") // VISIBILITY_SCOPES
  inviteMode  String? // 초청형: 상시 재진입형 | 시점 한정 시크릿 페이지형
  entryPoints String? // ENTRY_POINTS csv
  secretUrl   String?

  // 운영 기간
  startAt   DateTime?
  endAt     DateTime?
  noEndDate Boolean   @default(false)

  // 프로그램 승인 워크플로우 (PROGRAM_APPROVAL_STATUSES)
  approvalStatus      String    @default("DRAFT")
  approvalRequestedAt DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  rejectReason        String?

  // 상세 콘텐츠/고지 — 상세(등록정보)에서 관리, 빌더에선 고정 노출 (NC-EVTMSN-001 안내형)
  summary    String? // 핵심 혜택 요약
  notice     String? // 유의사항 (고정)
  faq        String?
  reward     String? // 보상 (일정/보상/대상 카드) — 미사용(레거시)
  target     String? // 대상 (일정/보상/대상 카드) — 미사용(레거시)
  usageSteps String? // 이용 방법 스텝(JSON) — 미사용(레거시)
  contact    String? // 문의 (안내형 하단 고정)

  // 응모형 (PG-EVTMSN-PROG-001 응모형) — 응모 버튼 + 응모/당첨/리워드 설정
  ctaLabel    String? // 응모 버튼명 (예: 응모하기)
  ctaUrl      String? // 응모 버튼 링크
  entryConfig String? // 응모/당첨/리워드 설정(JSON): 응모방식·당첨방식·당첨시점·당첨안내·당첨규모·참여조건·리워드[]

  defaultPageId String?    @unique
  defaultPage   EventPage? @relation("DefaultPage", fields: [defaultPageId], references: [id])

  pages    EventPage[]    @relation("ProgramPages")
  comments EventComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// SB-EVT-050 프로모션 상세 · 댓글 관리 — 프로모션(EventProgram)에 작성된 FO 고객 댓글.
//  운영자는 노출여부만 제어(노출/미노출). 답글은 대표 1건 + 총 개수를 비정규화해 목록에 요약 표기.
model EventComment {
  id             String       @id @default(cuid())
  programId      String
  program        EventProgram @relation(fields: [programId], references: [id])
  memberChannelId String      // 멤버십 채널 ID (작성 회원 고유 ID)
  content        String       // 댓글 내용
  likeCount      Int          @default(0) // 좋아요 수
  exposed        Boolean      @default(true) // 노출여부 (노출 | 미노출)
  answered       Boolean      @default(false) // 답변여부 (답글대기 | 답변완료)
  // 답글 요약(대표 1건 + 총 개수) — 목록 표기용 비정규화 캐시. 실제 답글은 EventCommentReply(사이드 패널에서 관리).
  replyContent String?  // 대표(최신) 답글 내용
  replyAuthor  String?  // 대표(최신) 답글 등록자(운영자)
  replyCount   Int      @default(0) // 총 답글 수
  replyAt      DateTime? // 최신 답글 등록일시
  createdAt    DateTime @default(now()) // 등록일시

  replies EventCommentReply[]

  @@index([programId])
}

// SB 댓글 상세 · 답글 등록 — 운영자가 한 댓글에 남기는 답글(여러 개 가능). 각 답글은 노출여부를 가진다.
model EventCommentReply {
  id        String       @id @default(cuid())
  commentId String
  comment   EventComment @relation(fields: [commentId], references: [id])
  content   String       // 답글 내용
  author    String       // 답글 등록자(운영자)
  exposed   Boolean      @default(true) // 답글 노출여부
  createdAt DateTime      @default(now())

  @@index([commentId])
}
